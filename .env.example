# ============================================================
# SkillPassport deployment environment variables
# Copy to .env and adjust for your environment.
#   cp .env.example .env
# ============================================================

# --- Frontend (Vite build arg, used by docker compose) ---
# Same-origin when frontend is served behind nginx (default).
# Point to your backend directly for separate hosting, e.g.:
#   VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1

# --- Backend (Spring Boot) ---
# STRONGLY RECOMMENDED: use a long random value in production:
#   openssl rand -hex 32
JWT_SECRET=9a4f2c8d7e1b5a3f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a6f
JWT_EXPIRATION_MS=86400000

# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (optional; defaults to H2) ---
# For production, set SPRING_PROFILES_ACTIVE=prod and uncomment:
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://db:5432/skillpassport
# DB_DRIVER=org.postgresql.Driver
# DB_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
# DB_USERNAME=skillpassport
# DB_PASSWORD=change-me

# H2 console (local dev only)
# H2_CONSOLE_ENABLED=true